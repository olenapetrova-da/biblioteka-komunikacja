# Kopiuj ten plik do .env i uzupełnij prawdziwymi wartościami.
# .env NIGDY nie trafia do repozytorium (patrz .gitignore).

# ID arkusza Google Sheets pełniącego rolę bazy pośredniej
# (Plik > Udostępnij > Kopiuj link, ID to fragment URL między /d/ a /edit)
SHEET_ID=

# ID projektu Apps Script (jeśli osobny od arkusza) — do uzupełnienia po
# utworzeniu projektu i skonfigurowaniu clasp
APPS_SCRIPT_ID=

# Adres e-mail / alias, z którego wysyłane są maile do czytelników
# (musi być zweryfikowanym aliasem na koncie Gmail używanym do wysyłki)
SENDER_EMAIL=

# TODO: uzupełnić o kolejne zmienne w miarę rozwoju projektu, np.:
# - identyfikator arkusza/folderu na treści Instagram
# - (przyszłość) dane dostępowe do Supabase, jeśli nastąpi migracja
# - (przyszłość) dane dostępowe do Instagram Graph API
